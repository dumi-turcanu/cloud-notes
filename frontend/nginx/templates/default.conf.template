# Rendered by the base image's envsubst step (only ${PORT} and
# ${NGINX_LOCAL_RESOLVERS} are substituted; $nginx_variables are untouched).
# This file is included in the http context. $api_upstream and
# $api_upstream_host come from /etc/nginx/conf.d/00-upstream.conf, written by
# docker-entrypoint.d/05-validate-env.sh.

log_format json escape=json
    '{"time":"$time_iso8601","remote_addr":"$remote_addr","method":"$request_method",'
    '"uri":"$uri","status":$status,"bytes":$body_bytes_sent,"request_time":$request_time,'
    '"upstream_status":"$upstream_status","request_id":"$req_id","user_agent":"$http_user_agent"}';

# Keep a client-supplied request id (the backend validates it); otherwise use nginx's.
map $http_x_request_id $req_id {
    default $http_x_request_id;
    ""      $request_id;
}

# Behind a TLS-terminating load balancer the original scheme arrives in
# X-Forwarded-Proto; the backend does not rely on it for any security decision.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

gzip on;
gzip_vary on;
gzip_min_length 256;
gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;

server {
    listen ${PORT};
    server_name _;

    server_tokens off;
    client_max_body_size 1m;
    absolute_redirect off;

    access_log /dev/stdout json;
    error_log /dev/stderr warn;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # Frontend liveness: does not call the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        return 200 "ok\n";
    }

    # API: proxied without path rewriting. A variable in proxy_pass makes nginx
    # re-resolve the upstream name through the resolver above.
    location /api/ {
        proxy_pass $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $api_upstream_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Request-ID $req_id;
        proxy_ssl_server_name on;
        proxy_ssl_name $api_upstream_host;
        proxy_connect_timeout 30s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        error_page 502 503 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        add_header X-Request-ID $req_id always;
        return 503 '{"error":"upstream_unavailable","message":"The API is temporarily unavailable. Please try again shortly."}';
    }

    # Fingerprinted build output: cache forever; a missing file is a real 404.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Static files and SPA fallback: always revalidate.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
