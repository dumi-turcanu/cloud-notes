# Cloud Notes API - local development configuration.
# Copy to `.env` (git-ignored) and adjust. The API loads `.env` from the working
# directory only if the file exists; real environments use real environment
# variables. Every variable marked (secret) also accepts <NAME>_FILE, a path to
# a file whose trimmed content is the value (the _FILE variant wins).

# --- Server -------------------------------------------------------------------
# Main listener. Defaults to ":$PORT" if PORT is set (Cloud Run etc.), else ":8080".
HTTP_ADDR=:8080
# Prefix of all application routes (must start with "/", no trailing slash).
API_BASE_PATH=/api
# Prometheus /metrics listener; empty disables it.
METRICS_ADDR=:9090
# debug | info | warn | error (JSON logs on stdout)
LOG_LEVEL=debug
# Time between "not ready" and closing listeners. Use ~5s behind load balancers
# (Kubernetes, ECS); 0s is fine locally.
SHUTDOWN_DELAY=0s
# Max time to drain in-flight requests on SIGTERM.
SHUTDOWN_TIMEOUT=15s
# Number of proxies that append to X-Forwarded-For in front of the API
# (0 = trust only the TCP peer).
TRUSTED_PROXY_HOPS=0
# Extra origins allowed to make state-changing cross-origin requests
# (comma-separated), e.g. https://notes.example.com. Same-origin needs none.
CSRF_TRUSTED_ORIGINS=

# --- Features -----------------------------------------------------------------
# Registers publish/unpublish and the public note route when true.
FEATURE_PUBLIC_SHARING=false
# Required when sharing is enabled: share_url = PUBLIC_APP_URL/shared/<uuid>
PUBLIC_APP_URL=

# --- Database -----------------------------------------------------------------
# Optional full DSN (secret); overrides the DB_* variables below.
# DATABASE_URL=postgres://cloudnotes:cloudnotes-local-only@localhost:5432/cloudnotes?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudnotes
DB_USER=cloudnotes
# (secret) LOCAL DEVELOPMENT ONLY throw-away value - never reuse it anywhere real.
DB_PASSWORD=cloudnotes-local-only
# disable | require | verify-ca | verify-full  (production default: require)
DB_SSLMODE=disable
# CA bundle path, required for verify-ca / verify-full.
DB_SSLROOTCERT=
DB_MAX_CONNS=10
# `serve` applies pending migrations first (safe with many replicas: advisory lock).
DB_MIGRATE_ON_START=true

# --- Authentication -----------------------------------------------------------
# Identity backend: local (default; e-mail + password in this database), oidc
# (AWS Cognito, Azure Entra External ID, Keycloak, ...) or identity-platform
# (GCP). See docs/authentication.md. The AUTH_SIGNUP_MODE etc. below are local only.
AUTH_PROVIDER=local
# disabled (default) | invite | open. Local development uses open.
AUTH_SIGNUP_MODE=open
# (secret) Required (>= 16 characters) when AUTH_SIGNUP_MODE=invite.
AUTH_INVITE_CODE=
# Absolute session lifetime and idle timeout.
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=1h
# true (default) uses the __Host- cookie prefix and needs HTTPS; false ONLY for
# plain-HTTP local development.
SESSION_COOKIE_SECURE=false
# Consecutive failed logins before the account is locked, and for how long.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_DURATION=15m
# Per client IP, for login and register.
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- AUTH_PROVIDER=oidc -----------------------------------------------------------
# Issuer exactly as in <issuer>/.well-known/openid-configuration. https only
# (http is accepted when SESSION_COOKIE_SECURE=false).
# OIDC_ISSUER_URL=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_XXXXXXXXX
# OIDC_CLIENT_ID=
# (secret) also OIDC_CLIENT_SECRET_FILE
# OIDC_CLIENT_SECRET=
# PUBLIC_APP_URL (above) is required in this mode.
# Default: $PUBLIC_APP_URL/api/auth/oidc/callback - register this at the provider.
# OIDC_REDIRECT_URL=
# OIDC_SCOPES=openid email profile
# OIDC_PROVIDER_NAME=Single sign-on
# Needed for Cognito (no end_session_endpoint in its discovery document):
# OIDC_LOGOUT_URL=https://<domain>/logout?client_id={client_id}&logout_uri={post_logout_redirect_uri}
# OIDC_POST_LOGOUT_REDIRECT_URL=
# Development only: fetch discovery from another host name than the issuer.
# OIDC_DISCOVERY_URL=

# --- AUTH_PROVIDER=identity-platform ---------------------------------------------
# IDP_PROJECT_ID=my-project
# Public by design (sent to the browser); restrict it by HTTP referrer.
# IDP_API_KEY=
# IDP_AUTH_DOMAIN=my-project.firebaseapp.com
# IDP_TENANT_ID=
# Comma-separated subset of password,google
# IDP_SIGN_IN_METHODS=password

# --- create-user command only (AUTH_PROVIDER=local) ---------------------------
# (secret) Password for `cloud-notes-api create-user --email you@example.com`.
# Alternatively pass it on stdin with --password-stdin. Leave unset normally.
# NEW_USER_PASSWORD=
